# Copy this file to .env and fill the values. Never commit .env.
DOTA_MYSQL_HOST=
DOTA_MYSQL_PORT=3306
DOTA_MYSQL_DATABASE=dota_review
DOTA_MYSQL_USER=dota_review_app
DOTA_MYSQL_PASSWORD=
DOTA_MYSQL_CONNECT_TIMEOUT=10
DOTA_MYSQL_SSL=false
DOTA_MYSQL_SSL_CA=

# Optional model provider; use a provider:model value supported by LangChain.
# Example: openai:gpt-4o-mini. If unset, the agent still runs its evidence-based
# analyses and returns a deterministic Chinese summary.
DOTA_AGENT_MODEL=
DOTA_AGENT_API_KEY=
DOTA_AGENT_BASE_URL=
DOTA_AGENT_STATE_DB=dota_data/agent-state.sqlite3
